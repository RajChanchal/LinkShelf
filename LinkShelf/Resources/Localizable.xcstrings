    "shortcut.intro.message": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på ⌥⌘L når som helst for at åbne LinkShelf fra menulinjen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke ⌥⌘L, um LinkShelf jederzeit über die Menüleiste zu öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press ⌥⌘L anytime to open LinkShelf from the menu bar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa ⌥⌘L para abrir LinkShelf desde la barra de menús en cualquier momento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa LinkShelf valikkoriviltä milloin tahansa painamalla ⌥⌘L."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur ⌥⌘L pour ouvrir LinkShelf depuis la barre des menus à tout moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi ⌥⌘L per aprire LinkShelf dalla barra dei menu in qualsiasi momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥⌘Lを押すと、いつでもメニューバーからLinkShelfを開けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥⌘L을 누르면 언제든지 메뉴 막대에서 LinkShelf를 열 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på ⌥⌘L når som helst for å åpne LinkShelf fra menylinjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Druk op ⌥⌘L om LinkShelf op elk moment via de menubalk te openen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima ⌥⌘L a qualquer momento para abrir o LinkShelf a partir da barra de menus."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione ⌥⌘L a qualquer momento para abrir o LinkShelf pela barra de menus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите ⌥⌘L, чтобы в любое время открыть LinkShelf из строки меню."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på ⌥⌘L när som helst för att öppna LinkShelf från menyraden."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下 ⌥⌘L 即可随时从菜单栏打开 LinkShelf。"
