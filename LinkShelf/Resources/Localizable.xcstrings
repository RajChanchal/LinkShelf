    "shortcut.intro.message": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på ⌥⌘L når som helst for at åbne LinkShelf fra menulinjen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke ⌥⌘L, um LinkShelf jederzeit über die Menüleiste zu öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press ⌥⌘L anytime to open LinkShelf from the menu bar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa ⌥⌘L para abrir LinkShelf desde la barra de menús en cualquier momento."
