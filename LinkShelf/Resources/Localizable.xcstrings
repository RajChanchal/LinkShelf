    "folder.delete.hint" : {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle bogmærker i denne mappe og dens undermapper slettes permanent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Lesezeichen in diesem Ordner und seinen Unterordnern werden dauerhaft gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All bookmarks in this folder and its nested folders will be permanently deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán permanentemente todos los marcadores de esta carpeta y sus subcarpetas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki tämän kansion ja sen alikansioiden kirjanmerkit poistetaan pysyvästi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les signets de ce dossier et de ses sous-dossiers seront définitivement supprimés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i segnalibri in questa cartella e nelle sottocartelle verranno eliminati definitivamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダとサブフォルダ内のすべてのブックマークが完全に削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 폴더와 하위 폴더의 모든 북마크가 영구적으로 삭제됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle bokmerker i denne mappen og undermappene slettes permanent."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle bladwijzers in deze map en de submappen worden permanent verwijderd."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os favoritos desta pasta e das suas subpastas serão eliminados permanentemente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os favoritos desta pasta e de suas subpastas serão excluídos permanentemente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все закладки в этой папке и вложенных папках будут удалены безвозвратно."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla bokmärken i den här mappen och dess undermappar raderas permanent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件夹及其子文件夹中的所有书签将被永久删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此資料夾及其子資料夾中的所有書籤將永久刪除。"
          }
        }
      }
    },
