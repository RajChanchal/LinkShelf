    "folder.new.hint" : {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast et unikt navn uden skråstreger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib einen eindeutigen Namen ohne Schrägstriche ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a unique name without slashes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce un nombre único sin barras."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna yksilöllinen nimi ilman kauttaviivoja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un nom unique sans barres obliques."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci un nome univoco senza barre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スラッシュを含まない重複しない名前を入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "슬래시 없이 고유한 이름을 입력하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv inn et unikt navn uten skråstreker."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer een unieke naam zonder schuine strepen in."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduza um nome único sem barras."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite um nome exclusivo sem barras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите уникальное имя без косых черт."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange ett unikt namn utan snedstreck."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入不含斜杠的唯一名称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
