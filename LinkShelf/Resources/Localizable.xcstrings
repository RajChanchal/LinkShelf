    "folder.rename.hint" : {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast et unikt mappenavn. Undermapper omdøbes også."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib einen eindeutigen Ordnernamen ein. Unterordner werden ebenfalls umbenannt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a unique folder name. Nested folders will be renamed too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce un nombre de carpeta único. También se renombrarán las subcarpetas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna yksilöllinen kansion nimi. Myös alikansiot nimetään uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un nom de dossier unique. Les sous-dossiers seront également renommés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci un nome di cartella univoco. Verranno rinominate anche le sottocartelle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "重複しないフォルダ名を入力してください。サブフォルダ名も変更されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고유한 폴더 이름을 입력하세요. 하위 폴더 이름도 변경됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv inn et unikt mappenavn. Undermapper får også nytt navn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer een unieke mapnaam in. Submappen worden ook hernoemd."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduza um nome de pasta único. As subpastas também serão renomeadas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite um nome de pasta exclusivo. As subpastas também serão renomeadas."
          }
        },
        "ru": {
